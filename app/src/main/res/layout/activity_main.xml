<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="实验三：Android 界面组件"
            android:textColor="#FF212121"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ListView · AlertDialog · Menu · ActionMode · RecyclerView"
            android:textColor="#FF757575"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_task1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="任务1：ListView + SimpleAdapter（含通知）"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_task2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="任务2：自定义布局的 AlertDialog"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_task3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="任务3：XML 定义菜单"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_task4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="任务4：ActionMode 上下文菜单"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_task5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="任务5：RecyclerView 列表"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:text="实验三 · 界面组件 | 单击各任务进入对应界面"
            android:textColor="#FF9E9E9E"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
