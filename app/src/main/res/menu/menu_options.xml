<?xml version="1.0" encoding="utf-8"?>
<!-- 实验3-3：使用 XML 定义选项菜单 -->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 字体大小：小（10号）/ 中（16号）/ 大（20号），单选 -->
    <item
        android:id="@+id/font_size"
        android:title="@string/menu_font_size">
        <menu>
            <group android:checkableBehavior="single">
                <item
                    android:id="@+id/size_small"
                    android:title="@string/menu_size_small" />
                <item
                    android:id="@+id/size_medium"
                    android:checked="true"
                    android:title="@string/menu_size_medium" />
                <item
                    android:id="@+id/size_large"
                    android:title="@string/menu_size_large" />
            </group>
        </menu>
    </item>

    <!-- 普通菜单项：点击弹出 Toast -->
    <item
        android:id="@+id/normal_item"
        android:title="@string/menu_normal_item" />

    <!-- 字体颜色：红色 / 黑色，单选 -->
    <item
        android:id="@+id/font_color"
        android:title="@string/menu_font_color">
        <menu>
            <group android:checkableBehavior="single">
                <item
                    android:id="@+id/color_black"
                    android:checked="true"
                    android:title="@string/menu_color_black" />
                <item
                    android:id="@+id/color_red"
                    android:title="@string/menu_color_red" />
            </group>
        </menu>
    </item>
</menu>
