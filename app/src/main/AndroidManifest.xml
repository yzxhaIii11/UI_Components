<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 实验3-1：单击列表项发送通知，Android 13（API 33）+ 需要运行时通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UI_Components">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 实验3-1：ListView + SimpleAdapter + 通知 -->
        <activity android:name=".ListViewActivity" android:exported="false" />

        <!-- 实验3-2：自定义布局的 AlertDialog -->
        <activity android:name=".AlertDialogActivity" android:exported="false" />

        <!-- 实验3-3：XML 定义菜单（使用带 ActionBar 的主题显示选项菜单） -->
        <activity
            android:name=".MenuActivity"
            android:exported="false"
            android:theme="@style/Theme.UI_Components.Menu" />

        <!-- 实验3-4：ActionMode 上下文操作菜单 -->
        <activity android:name=".ActionModeActivity" android:exported="false" />

        <!-- 实验3-5：RecyclerView 列表 -->
        <activity android:name=".RecyclerViewActivity" android:exported="false" />
    </application>

</manifest>
